<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel.hotelbooking.controller.CustomerController"
            style="-fx-background-color: #f4f6f9;">

    <!-- ===== TITLE ===== -->
    <top>
        <Label text="CUSTOMER MANAGEMENT"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 20 0 10 0;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- ===== CONTENT ===== -->
    <center>
        <VBox spacing="20">

            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>

            <!-- ===== FORM ===== -->
            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="75"/>
                </columnConstraints>

                <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtName"
                           promptText="Enter full name"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Phone:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPhone"
                           promptText="Enter phone (10-11 digits)"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEmail"
                           promptText="Enter email (example@gmail.com)"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <Label text="ID Card:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtIdCard"
                           promptText="Enter ID card (9-12 digits)"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>

            </GridPane>

            <!-- ===== BUTTONS ===== -->
            <HBox spacing="15" alignment="CENTER">

                <Button text="Add"
                        onAction="#handleAdd"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 6;"/>

                <Button text="Update"
                        onAction="#handleUpdate"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 6;"/>

                <Button text="Delete"
                        onAction="#handleDelete"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 6;"/>

                <Button text="Clear"
                        onAction="#handleClear"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 6;"/>

            </HBox>

            <!-- ===== TABLE ===== -->
            <TableView fx:id="tableView" prefHeight="320">

                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colName" text="Full Name" prefWidth="180"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="130"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
                    <TableColumn fx:id="colIdCard" text="ID Card" prefWidth="140"/>
                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>
