<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane
    prefWidth="980" prefHeight="740"
    xmlns="http://javafx.com/javafx/11"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.hotel.hotelbooking.controller.BookingController">

    <!-- ═══════════════════════ TOP HEADER ═══════════════════════ -->
    <top>
        <VBox style="-fx-padding: 15 20 10 20; -fx-background-color: #1e3a5f;">
            <Label text="📋  BOOKING MANAGEMENT"
                   textFill="WHITE"
                   style="-fx-font-size: 22; -fx-font-weight: bold;" />
            <Label text="Hotel Booking System — Manage reservations"
                   textFill="#93c5fd"
                   style="-fx-font-size: 12;" />
        </VBox>
    </top>

    <!-- ═══════════════════════ CENTER ═══════════════════════════ -->
    <center>
        <VBox spacing="12" style="-fx-padding: 15;">

            <!-- ─── Booking Form ─── -->
            <!-- Click on empty area inside this pane to reset the form -->
            <TitledPane animated="false" collapsible="false"
                        text="➕  New / Edit Booking"
                        style="-fx-font-weight: bold;">
                <content>
                    <VBox spacing="8" style="-fx-padding: 12;">

                        <!-- Row 1: Customer | Room -->
                        <GridPane hgap="20" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="110" prefWidth="120" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="160" />
                                <ColumnConstraints halignment="RIGHT" minWidth="110" prefWidth="120" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="160" />
                            </columnConstraints>

                            <!-- Customer -->
                            <Label text="Customer:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-weight: bold;" />
                            <ComboBox fx:id="cboCustomer" prefWidth="180"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <!-- Room -->
                            <Label text="Room:" GridPane.columnIndex="2" GridPane.rowIndex="0"
                                   style="-fx-font-weight: bold;" />
                            <ComboBox fx:id="cboRoom" prefWidth="180"
                                      GridPane.columnIndex="3" GridPane.rowIndex="0" />

                            <!-- Check-in -->
                            <Label text="Check-in Date:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-weight: bold;" />
                            <DatePicker fx:id="dpCheckinDate" prefWidth="180"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <!-- Check-out -->
                            <Label text="Check-out Date:" GridPane.columnIndex="2" GridPane.rowIndex="1"
                                   style="-fx-font-weight: bold;" />
                            <DatePicker fx:id="dpCheckoutDate" prefWidth="180"
                                        GridPane.columnIndex="3" GridPane.rowIndex="1" />

                            <!-- Room Price -->
                            <Label text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-weight: bold;" />
                            <Label fx:id="lblRoomPrice" text="0 VND"
                                   style="-fx-font-weight: bold; -fx-text-fill: #dc2626;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <!-- Total Price -->
                            <Label text="Total Price:" GridPane.columnIndex="2" GridPane.rowIndex="2"
                                   style="-fx-font-weight: bold;" />
                            <Label fx:id="lblTotalPrice" text="0 VND"
                                   style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #16a34a;"
                                   GridPane.columnIndex="3" GridPane.rowIndex="2" />

                            <!-- Status -->
                            <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-weight: bold;" />
                            <ComboBox fx:id="cboStatus" prefWidth="180"
                                      GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <!-- Action Buttons -->
                            <HBox spacing="10" GridPane.columnIndex="2" GridPane.columnSpan="2"
                                  GridPane.rowIndex="3" alignment="CENTER_LEFT">
                                <Button fx:id="btnSave"
                                        text="✅  Create Booking"
                                        onAction="#handleSave"
                                        prefWidth="150"
                                        style="-fx-font-weight: bold; -fx-background-color: #16a34a; -fx-text-fill: white;" />
                                <Button fx:id="btnDelete"
                                        text="🗑  Delete"
                                        onAction="#handleDelete"
                                        prefWidth="100"
                                        style="-fx-font-weight: bold; -fx-background-color: #dc2626; -fx-text-fill: white;" />
                                <Button fx:id="btnReset"
                                        text="🔄  Reset"
                                        onAction="#handleReset"
                                        prefWidth="90"
                                        style="-fx-font-weight: bold;" />
                            </HBox>
                        </GridPane>

                        <!-- Inline date-warning label (hidden by default) -->
                        <Label fx:id="lblDateWarning"
                               text=""
                               visible="false"
                               style="-fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-font-size: 12;" />

                    </VBox>
                </content>
            </TitledPane>

            <!-- ─── Booking List ─── -->
            <TitledPane animated="false" collapsible="false"
                        text="📋  Booking List"
                        style="-fx-font-weight: bold;"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="8" style="-fx-padding: 10;">

                        <!-- Filter buttons -->
                        <HBox spacing="8">
                            <Button fx:id="btnShowAll"
                                    text="All"
                                    onAction="#handleShowAll" />
                            <Button fx:id="btnShowConfirmed"
                                    text="Confirmed"
                                    onAction="#handleShowConfirmed" />
                            <Button fx:id="btnShowPending"
                                    text="Pending"
                                    onAction="#handleShowPending" />
                            <Button fx:id="btnShowCancelled"
                                    text="Cancelled"
                                    onAction="#handleShowCancelled" />
                        </HBox>

                        <!-- Table (no Action column — edit/delete via form above) -->
                        <TableView fx:id="tblBooking" prefHeight="280" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBookingId"  text="ID"          minWidth="55"  prefWidth="65" />
                                <TableColumn fx:id="colCustomer"   text="Customer"    minWidth="130" prefWidth="160" />
                                <TableColumn fx:id="colRoom"       text="Room"        minWidth="80"  prefWidth="100" />
                                <TableColumn fx:id="colCheckin"    text="Check-in"    minWidth="100" prefWidth="120" />
                                <TableColumn fx:id="colCheckout"   text="Check-out"   minWidth="100" prefWidth="120" />
                                <TableColumn fx:id="colTotalPrice" text="Total Price" minWidth="110" prefWidth="130" />
                                <TableColumn fx:id="colStatus"     text="Status"      minWidth="100" prefWidth="120" />
                            </columns>
                            <placeholder>
                                <Label text="No bookings found." style="-fx-text-fill: #6b7280;" />
                            </placeholder>
                        </TableView>

                    </VBox>
                </content>
            </TitledPane>

        </VBox>
    </center>

    <!-- ═══════════════════════ BOTTOM BAR ═══════════════════════ -->
    <bottom>
        <HBox spacing="10" style="-fx-padding: 12 20;" alignment="CENTER_LEFT">
            <Button fx:id="btnExportCSV"
                    text="📥  Export CSV"
                    onAction="#handleExportCSV"
                    prefWidth="130"
                    style="-fx-font-weight: bold;" />
            <Separator HBox.hgrow="ALWAYS" />
            <Button fx:id="btnBack"
                    text="⬅  Back"
                    onAction="#handleBack"
                    prefWidth="100"
                    style="-fx-font-weight: bold;" />
        </HBox>
    </bottom>

</BorderPane>
