<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="500.0" prefWidth="400.0" spacing="10" stylesheets="@chatbot.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.hotelbooking.chatbot.ChatBotController">
    <children>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" text="⬅ Back" styleClass="back-button"/>
                <Label text="Hotel ChatBot - Hỗ trợ đặt phòng" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </children>
        </HBox>
        
        <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="chat-scroll-pane">
            <content>
                <VBox fx:id="chatBox" spacing="10" styleClass="chat-container">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <HBox spacing="10">
            <children>
                <TextField fx:id="inputField" HBox.hgrow="ALWAYS" promptText="Nhập tin nhắn..." onAction="#handleSend"/>
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleSend" text="Gửi" styleClass="send-button"/>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>
