<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="591.0" prefWidth="942.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.hotelbooking.controller.DashboardController"
            stylesheets="@style.css">
         <top>
        <HBox prefHeight="60"
              alignment="CENTER_LEFT"
              spacing="20"
              style="-fx-background-color: #8fb3b6;">

            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <!-- Title -->
            <Label text="HOTEL BOOKING SYSTEM"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;" />

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Buttons -->
            <Button fx:id="btnRooms"
                    text="Rooms Management"
                    onAction="#handleRooms"
                    prefWidth="175"
                    prefHeight="35"/>

            <Button fx:id="btnCustomers"
                    text="Customers Management"
                    onAction="#handleCustomers"
                    prefWidth="175"
                    prefHeight="35"/>

            <Button fx:id="btnBookings"
                    text="Bookings Management"
                    onAction="#handleBookings"
                    prefWidth="175"
                    prefHeight="35"/>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

        </HBox>
    </top>
   <center>
      <AnchorPane fx:id="contentArea"/>
            alignment="TOP_CENTER"
            spacing="20.0">

         <padding>
            <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
         </padding>

         <Label text="HOTEL BOOKING SYSTEM" textFill="#2c3e50">
            <font>
               <Font name="System Bold" size="28.0"/>
            </font>
         </Label>

         <Label text="Welcome to Hotel Management System" textFill="#7f8c8d">
            <font>
               <Font size="14.0"/>
            </font>
         </Label>

      </AnchorPane>
   </center>

   

</BorderPane>