<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="591.0"
            prefWidth="942.0"
            stylesheets="@../../../style.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.hotelbooking.controller.DashboardController">

   <center>
      <VBox fx:id="contentBox"
            alignment="TOP_CENTER"
            spacing="20.0">

         <padding>
            <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
         </padding>

         <Label text="HOTEL BOOKING SYSTEM" textFill="#2c3e50">
            <font>
               <Font name="System Bold" size="28.0"/>
            </font>
         </Label>

         <Label text="Welcome to Hotel Management System" textFill="#7f8c8d">
            <font>
               <Font size="14.0"/>
            </font>
         </Label>

      </VBox>
   </center>

   <top>
      <HBox spacing="20.0"
            minHeight="60.0"
            styleClass="header-bar"
            BorderPane.alignment="CENTER_LEFT">

         <Label text="Hotel Management">
            <font>
               <Font name="System Bold" size="18.0"/>
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS"/>

         
         <Button text="Rooms"/>
         <Button text="Booking"/>
         <Button text="Customer"/>

      </HBox>
   </top>

</BorderPane>