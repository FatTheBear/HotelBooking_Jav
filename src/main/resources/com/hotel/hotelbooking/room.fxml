<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Room Management Screen (SPA view)
  - Left: Create/Update form
  - Center: Room table
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.hotelbooking.controller.RoomController">

    <!-- ===== LEFT: FORM ===== -->
    <left>
        <VBox spacing="10" prefWidth="320">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Room Management" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="lblHint"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="90" prefWidth="90" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <!-- Room Number -->
                <Label text="Number:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtRoomNumber" promptText="e.g., 101"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Room Type -->
                <Label text="Type:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cboRoomType" promptText="Select type"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Price -->
                <Label text="Price:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPrice" promptText="e.g., 500000"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Capacity -->
                <Label text="Capacity:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="spnCapacity" editable="true"
                         GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Status -->
                <Label text="Status:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cboStatus" promptText="Select status"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Description -->
                <Label text="Description:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextArea fx:id="txtDescription" promptText="Optional notes..."
                          prefRowCount="3" wrapText="true"
                          GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Buttons -->
            <HBox spacing="10">
                <Button fx:id="btnCreate" text="Create" onAction="#handleCreate" />
                <Button fx:id="btnUpdate" text="Update" onAction="#handleUpdate" disable="true" />
                <Button fx:id="btnDelete" text="Delete" onAction="#handleDelete" disable="true" />
                <Button fx:id="btnReset"  text="Reset"  onAction="#handleReset" />
            </HBox>

            <Separator/>

            <!-- Optional quick search -->
            <Label text="Search:"/>
            <TextField fx:id="txtSearch" promptText="Search by room number/type/status..."/>

        </VBox>
    </left>

    <!-- ===== CENTER: TABLE ===== -->
    <center>
    <VBox spacing="10">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>

        <Label text="Rooms" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <TableView fx:id="tblRooms" prefHeight="600">
            <columns>
                <TableColumn fx:id="colId"        text="ID"          prefWidth="60"/>
                <TableColumn fx:id="colNumber"    text="Number"      prefWidth="90"/>
                <TableColumn fx:id="colType"      text="Type"        prefWidth="120"/>
                <TableColumn fx:id="colPrice"     text="Price"       prefWidth="120"/>
                <TableColumn fx:id="colCapacity"  text="Capacity"    prefWidth="90"/>
                <TableColumn fx:id="colStatus"    text="Status"      prefWidth="120"/>
                <TableColumn fx:id="colDesc"      text="Description" prefWidth="220"/>
            </columns>
        </TableView>
    </VBox>
</center>

</BorderPane>